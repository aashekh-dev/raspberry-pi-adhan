[Unit]
Description=Adhan daemon and web app
After=network-online.target sound.target bluetooth.service user@@ADHAND_UID@.service
Wants=network-online.target bluetooth.service user@@ADHAND_UID@.service

[Service]
User=@ADHAND_USER@
SupplementaryGroups=audio
WorkingDirectory=@ADHAND_REPO@
ExecStart=/usr/bin/env .venv/bin/uvicorn main:app --host 0.0.0.0 --port 8000
Restart=always
RestartSec=5
Environment="HOME=@ADHAND_HOME@"
Environment="XDG_RUNTIME_DIR=/run/user/@ADHAND_UID@"
Environment="DBUS_SESSION_BUS_ADDRESS=unix:path=/run/user/@ADHAND_UID@/bus"
Environment="PULSE_SERVER=unix:/run/user/@ADHAND_UID@/pulse/native"

[Install]
WantedBy=multi-user.target
